# Claude API key (Anthropic), read only by server.js, never exposed to the browser.
# This powers the public chat widget. Create a key at:
#   https://console.anthropic.com/settings/keys
# The account needs credit on it. Without a valid key the widget still answers,
# but only from the site's own data (offline mode), with no conversation.
ANTHROPIC_API_KEY=your-api-key-here

# Optional. Defaults to claude-haiku-4-5, the cheapest current Claude model.
# The knowledge base is sent as a cached prefix, so follow-up messages in the
# same conversation cost roughly a tenth of the first one.
# ANTHROPIC_MODEL=claude-haiku-4-5

# Server Configuration
PORT=3001

# ---------------------------------------------------------------------------
# Admin backend base URL — where the PUBLIC Contact / RFQ / Careers forms POST.
#
# THIS MUST BE SET FOR PRODUCTION BUILDS. Vite inlines VITE_* variables at BUILD
# time, so if this is unset the deployed bundle ships the hard-coded fallback
# `http://localhost:8080` (see src/data/adminApi.js) and every submitted form
# fails in the visitor's browser with "Could not send…". Setting it after deploy
# has no effect — it has to be present when `npm run build` runs.
#
# Local development against the Spring Boot backend on the default port:
# VITE_ADMIN_API=http://localhost:8080
#
# Production:
VITE_ADMIN_API=https://api.your-backend-host.com

# Claude API key (Anthropic), read only by server.js, never exposed to the browser.
# This powers the public chat widget. Create a key at:
#   https://console.anthropic.com/settings/keys
# The account needs credit on it. Without a valid key the widget still answers,
# but only from the site's own data (offline mode), with no conversation.
ANTHROPIC_API_KEY=your-api-key-here

# Optional. Defaults to claude-haiku-4-5, the cheapest current Claude model.
# The knowledge base is sent as a cached prefix, so follow-up messages in the
# same conversation cost roughly a tenth of the first one.
# ANTHROPIC_MODEL=claude-haiku-4-5

# Server Configuration
PORT=3001

# ---------------------------------------------------------------------------
# Where the Spring Boot admin backend is: NOTHING TO SET, normally.
#
# The site calls its API on its OWN origin (`/api/...`, `/uploads/...`) and a proxy hands
# those to Spring Boot:
#   - production:            the `rewrites` in vercel.json -> the Railway backend
#   - npm run dev / preview: the `proxy` in vite.config.js -> http://localhost:8080
# One origin means the login cookie is first-party, which is what keeps the admin console
# working in browsers that block third-party cookies. To move the backend, change the
# destination in vercel.json. No build-time variable is involved.
#
# VITE_API_DIRECT_ORIGIN bypasses that proxy and calls the given origin directly. Only for
# a special build, e.g. a preview pointed at a staging API. It is inlined at BUILD time,
# and a cross-site origin brings the third-party-cookie problem back for the console.
# The old name VITE_ADMIN_API is retired and ignored.
# VITE_API_DIRECT_ORIGIN=https://staging-api.example.com

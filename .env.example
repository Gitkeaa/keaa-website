# Google Gemini API Key — read only by server.js, never exposed to the browser.
# Get your key from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your-api-key-here

# Optional — overrides the primary model. server.js otherwise walks MODEL_CHAIN.
# GEMINI_MODEL=gemini-2.5-flash-lite

# Server Configuration
PORT=3001

{
  "name": "keaa-international-website",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:server": "node server.js",
    "dev:all": "concurrently \"npm run dev\" \"npm run dev:server\"",
    "gen:categories": "node scripts/gen-categories.mjs",
    "gen:sitemap": "node scripts/gen-categories.mjs && node scripts/gen-sitemap.mjs",
    "prebuild": "node scripts/gen-categories.mjs && node scripts/gen-sitemap.mjs",
    "build": "vite build && node scripts/gen-search-index.mjs",
    "preview": "vite preview"
  },
  "dependencies": {
    "@google/generative-ai": "^0.21.0",
    "apexcharts": "^6.5.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "framer-motion": "^11.3.19",
    "jspdf": "^4.2.1",
    "lucide-react": "^0.408.0",
    "react": "^18.3.1",
    "react-apexcharts": "^2.1.1",
    "react-dom": "^18.3.1",
    "react-easy-crop": "^6.2.2",
    "react-markdown": "^9.1.0",
    "react-router-dom": "^6.25.1",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@prerenderer/renderer-puppeteer": "^1.2.4",
    "@prerenderer/rollup-plugin": "^0.3.12",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.19",
    "concurrently": "^8.2.2",
    "postcss": "^8.4.40",
    "tailwindcss": "^3.4.7",
    "vite": "^5.3.4"
  }
}

{
  "name": "keaa-international-website",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:backend": "node scripts/dev-backend.mjs",
    "dev:server": "node server.js",
    "dev:all": "concurrently -k -n web,api -c cyan,green \"npm run dev\" \"npm run dev:backend\"",
    "gen:categories": "node scripts/gen-categories.mjs",
    "gen:sitemap": "node scripts/gen-categories.mjs && node scripts/gen-sitemap.mjs",
    "prebuild": "node scripts/gen-categories.mjs && node scripts/gen-sitemap.mjs",
    "build": "vite build && node scripts/check-prerender.mjs && node scripts/make-404.mjs && node scripts/gen-search-index.mjs",
    "check:prerender": "node scripts/check-prerender.mjs",
    "export:chat-kb": "node scripts/export-chat-kb.mjs",
    "check:secrets": "node scripts/check-secrets.mjs",
    "check:i18n": "node scripts/check-translations.mjs",
    "check:i18n:products": "node scripts/check-product-i18n.mjs",
    "check:leak": "node scripts/check-english-leak.mjs",
    "gen:proof": "node scripts/gen-proof-pdf.mjs",
    "snapshot:text": "node scripts/snapshot-text.mjs",
    "preview": "vite preview"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.115.0",
    "apexcharts": "^6.5.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "framer-motion": "^11.3.19",
    "jspdf": "^4.2.1",
    "lucide-react": "^0.408.0",
    "react": "^18.3.1",
    "react-apexcharts": "^2.1.1",
    "react-dom": "^18.3.1",
    "react-easy-crop": "^6.2.2",
    "react-markdown": "^9.1.0",
    "react-router-dom": "^6.25.1",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@prerenderer/renderer-puppeteer": "^1.2.4",
    "@prerenderer/rollup-plugin": "^0.3.12",
    "@sparticuz/chromium": "^153.0.0",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.19",
    "concurrently": "^8.2.2",
    "eslint": "^9.39.5",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^17.7.0",
    "pdf-lib": "^1.17.1",
    "postcss": "^8.4.40",
    "puppeteer": "^25.3.0",
    "tailwindcss": "^3.4.7",
    "vite": "^5.3.4"
  }
}
